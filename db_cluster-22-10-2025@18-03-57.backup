-- Name: WeatherData id; Type: DEFAULT; Schema: public; Owner: postgres
--

ALTER TABLE ONLY public."WeatherData" ALTER COLUMN id SET DEFAULT nextval('public."WeatherData_id_seq"'::regclass);


